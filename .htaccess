# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value error_log "/home/dytxzhkh/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/dytxzhkh/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# ============================================================
# Alasandong — caching, kompresi & kanonikalisasi URL.
# Blok cPanel di atas WAJIB dipertahankan. Jangan hapus.
# Menjawab audit PageSpeed "Gunakan durasi cache yang efisien".
# ============================================================

# Pastikan sitemap & robots ditayangkan dengan tipe konten benar.
# Beberapa shared host (LiteSpeed) mengirim XML sebagai text/plain,
# yang membuat Search Console gagal mengambil peta situs.
AddType application/xml .xml
AddType text/plain .txt

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html adalah duplikat dari / — Search Console melaporkannya sebagai
  # "Halaman alternatif dengan tag kanonis yang tepat". Redirect permanen agar
  # hanya ada satu URL beranda.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Aset statis ber-hash/bernama tetap: cache panjang.
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"

  # CSS/JS: 1 bulan. Naikkan setelah kamu pakai versi di query string
  # (mis. style.css?v=18) supaya update tetap cepat sampai ke user.
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"

  # HTML & service worker harus selalu segar.
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Sitemap & robots: jangan di-cache lama supaya update cepat terlihat bot.
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
